# --- Asosiy ---
NODE_ENV=production
PORT=3000
APP_TZ=Asia/Tashkent
LOG_LEVEL=info

# --- Xavfsizlik (production uchun MAJBURIY) ---
# Kamida 32 belgi. Yaratish: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800
# Kamida 8 belgi. Birinchi ishga tushirishda 'admin' va 'U001' foydalanuvchilari shu parollar bilan yaratiladi (dev standart: 12345678)
ADMIN_PASSWORD=
EMPLOYEE_PASSWORD=12345678

# Admin paneli domeni(lari), vergul bilan. Bo'sh bo'lsa faqat same-origin
CORS_ORIGINS=http://localhost:5173
# Reverse proxy (nginx, traefik) ortida bo'lsa 1 qiling: X-Forwarded-For ishlatiladi
TRUST_PROXY=0

# --- Cheklovlar ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
BODY_LIMIT_BYTES=100000

# --- Ma'lumotlar bazasi ---
DB_PATH=/app/data/app.db

# --- Demo ma'lumotlar (faqat sinov uchun!) ---
SEED_DEMO=false
DEMO_PASSWORD=

# --- client servisi (docker compose --profile tools run --rm client) ---
API_ID=admin
API_PASSWORD=
